          "name": "List Audit Trail Records",
          "request": {
            "name": "List Audit Trail Records",
            "description": {
              "content": "Lists all audit trail records for the authenticated user's business matching the filter criteria.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "audit-trail"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "actorId",
                  "value": "<string>",
                  "description": "Filter audit trail records by actor ID."
                },
                {
                  "disabled": false,
                  "key": "walletId",
                  "value": "<string>",
                  "description": "Filter audit trail records by wallet ID."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter audit trail records by type (business or wallet)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<double>",
                  "description": "The maximum number of audit trail records to return (optional)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<double>",
                  "description": "The offset for pagination (optional)."
                },
                {
                  "disabled": false,
                  "key": "orderBy",
                  "value": "<string>",
                  "description": "Sort audit trail records by a field. Available fields: createdAt (optional)."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort direction. Available values: asc, desc. (optional)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
